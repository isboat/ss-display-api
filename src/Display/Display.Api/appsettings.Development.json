{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Disabled": false,
    "DisabledTenantId": "development-tenant",
    "DisabledDeviceId": "development-device"
  },
  "Jwt": {
    "Issuer": "http://localhost",
    "Audience": "http://localhost/display-api",
    "SigningKey": "development-only-signing-key-change-for-production"
  },
  "DeviceAuthentication": {
    "VerificationUrl": "https://dashboard.onscreensync.com/#/device/auth",
    "DeviceCodeExpiresInSeconds": 1800,
    "PollingIntervalSeconds": 5,
    "AccessTokenLifetimeDays": 3,
    "RefreshTokenLifetimeDays": 365
  },
  "SignalR": {
    "AzureSignalRConnectionString": "Endpoint=https://example.service.signalr.net;AccessKey=development-placeholder;Version=1.0;"
  },
  "MongoSettings": {
    "ConnectionString": "mongodb://localhost:27017"
  }
}
